# ---------------------------------------------------------------- database
# Local file by default. Point at a libSQL/Turso URL to run hosted instead.
DATABASE_URL="file:./data/life-os.db"
# DATABASE_AUTH_TOKEN=""

# ------------------------------------------------------------------- auth
# Signing key for session cookies. Generate with: npm run generate:secret
AUTH_SECRET=""

# --------------------------------------------------------------------- AI
# Optional. Without it the Chief of Staff falls back to deterministic answers
# computed from your data rather than failing.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# ------------------------------------------------------- push notifications
# Optional. Generate a keypair with: npm run generate:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ------------------------------------------------------------- scheduler
# Shared secret protecting /api/cron/notifications. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""

# ------------------------------------------------------------- timezone
# A hosted server runs in UTC, which shifts quiet hours and rolls the day over
# at the wrong moment. Vercel reserves the name TZ, hence this one.
APP_TIMEZONE="America/Chicago"

# ------------------------------------------------------------ integrations
# Google Calendar. Create an OAuth client at console.cloud.google.com, type
# "Web application", and register this exact redirect URI:
#   <your app URL>/api/integrations/google-calendar/callback
# See DEPLOY.md for the full walkthrough.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The canonical URL of this deployment. Used for OAuth redirects, which must
# match what is registered at the provider byte for byte.
APP_URL=""
